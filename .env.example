MINIMAX_API_KEY=replace-with-minimax-master-key
PORTKEY_PROVIDER=minimax
PORTKEY_CONFIG=
PORTKEY_BASE_URL=http://portkey:8787

DATABASE_PATH=/data/database.db
REDIS_URL=redis://redis:6379/0

POIESIS_ADMIN_TOKEN=replace-with-local-admin-token
DRY_RUN_UPSTREAM=true
ALLOW_STREAMING=false

MONTHLY_TOKEN_CEILING=185700000
RATE_WINDOW_SECONDS=18000
STANDARD_WINDOW_LIMIT=642
HIGH_SPEED_WINDOW_LIMIT=321
BURST_WINDOW_SECONDS=60
STANDARD_BURST_LIMIT=2
HIGH_SPEED_BURST_LIMIT=1

GATEWAY_BRAIN_URL=http://gateway-brain:8000
