MINIMAX_API_KEY=replace-with-minimax-master-key
PORTKEY_PROVIDER=minimax
PORTKEY_CONFIG=
PORTKEY_BASE_URL=http://portkey:8787
PORTKEY_IMAGE=portkeyai/gateway:latest

DATABASE_PATH=/data/database.db
REDIS_URL=redis://redis:6379/0

POIESIS_ADMIN_TOKEN=replace-with-local-admin-token
ALLOW_INSECURE_ADMIN=false
POIESIS_KEY_HASH_SECRET=replace-with-local-key-hash-secret
DRY_RUN_UPSTREAM=true
ALLOW_STREAMING=false
MAX_REQUEST_BODY_BYTES=262144
MAX_MESSAGES=64
MAX_MESSAGE_CONTENT_CHARS=16000
MAX_TOTAL_MESSAGE_CONTENT_CHARS=64000

MONTHLY_TOKEN_CEILING=185700000
RATE_WINDOW_SECONDS=18000
STANDARD_WINDOW_LIMIT=642
HIGH_SPEED_WINDOW_LIMIT=321
DEFAULT_REQUEST_TIER=standard
HIGH_SPEED_STUDENT_IDS=
POIESIS_ALLOWED_MODELS=
POIESIS_BLOCKED_MODELS=
POIESIS_STUDENT_ALLOWED_MODELS=
POIESIS_STUDENT_BLOCKED_MODELS=
BURST_WINDOW_SECONDS=60
STANDARD_BURST_LIMIT=2
HIGH_SPEED_BURST_LIMIT=1

GATEWAY_BRAIN_URL=http://gateway-brain:8000

# Optional host port overrides for docker compose.
GATEWAY_BRAIN_PORT=8000
DASHBOARD_PORT=3000
PORTKEY_PORT=8787
REDIS_PORT=6379
